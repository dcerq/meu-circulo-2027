rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Meu Círculo 2027: cada conta Google só lê e escreve a própria pasta.
    // circulo/{uid}              → meta (configuração, dias reservados, leitura do Google Agenda)
    // circulo/{uid}/pessoas/{id} → pessoas do círculo
    // circulo/{uid}/encontros/{id} → encontros, com o histórico de status de cada um
    match /circulo/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
